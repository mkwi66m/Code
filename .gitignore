def decrypt_caesar(ciphertext, shift):
    decrypted = ""
    for char in ciphertext:
        if char.isalpha():
            offset = 65 if char.isupper() else 97
            decrypted += chr((ord(char) - offset - shift) % 26 + offset)
        else:
            decrypted += char
    return decrypted

# Example usage:
cipher_text = "Wklv lv d whvw phvvdjh"  # "This is a test message" with shift 3
print("Decrypted Caesar:", decrypt_caesar(cipher_text, 3))
